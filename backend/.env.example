# ================================
# NEXUS INTELLECT — ENVIRONMENT VARIABLES
# ================================
# Copy this to .env and fill in your values

# ── Server ──────────────────────
NODE_ENV=development
PORT=5000
CLIENT_URL=http://localhost:5173

# ── MongoDB ─────────────────────
MONGO_URI=mongodb://localhost:27017/nexus_intellect

# ── Redis ───────────────────────
REDIS_URL=redis://localhost:6379
REDIS_MOCK=true   # Set to false when Redis is available

# ── JWT ─────────────────────────
JWT_SECRET=nexus_intellect_super_secret_jwt_key_change_in_production_256bit
JWT_REFRESH_SECRET=nexus_intellect_refresh_secret_key_change_in_production_256bit
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=7d

# ── Bcrypt ──────────────────────
BCRYPT_SALT_ROUNDS=12

# ── Email (SMTP) ─────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password
SMTP_FROM="Nexus Intellect <noreply@nexus.edu>"

# ── Twilio (SMS/WhatsApp) ────────
TWILIO_ACCOUNT_SID=your_twilio_account_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_PHONE_NUMBER=+1234567890
TWILIO_WHATSAPP_NUMBER=whatsapp:+14155238886
NOTIFICATION_DRY_RUN=true   # Set to false to send real SMS/WhatsApp

# ── Cloudinary (File Upload) ─────
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret
USE_LOCAL_UPLOAD=true   # Set to false to use Cloudinary

# ── Rate Limiting ────────────────
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100
AUTH_RATE_LIMIT_MAX=10

# ── Logging ──────────────────────
LOG_LEVEL=debug
LOG_DIR=src/logs
